# Fill in the providers you use. Never commit .env.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Optional model overrides (or pass --model on the command line)
# BAKEOFF_CLAUDE_MODEL=claude-sonnet-5-5
# BAKEOFF_CLAUDE_EFFORT=high
GEMINI_MODEL=gemini-flash-latest
# OPENROUTER_MODEL=<a model that is free today, ending in :free>
# GROQ_MODEL=<a free model on Groq>
# OPEN_MODEL_VISION=1   (only if that model accepts images; enables the screenshot critic)
